# ---- FREE setup (Oracle + Gemini): deploy/setup.sh writes these for you ----
# LLM_PROVIDER=openai
# GEMINI_API_KEY=            # https://aistudio.google.com/apikey
# OPENAI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# ALLOWED_MODELS=gemini-3.8-flash
# SANDBOX_PROVIDER=docker
# MAX_RUNS_PER_USER_PER_DAY=15

# ---- PAID setup (Claude + E2B) ----
# Claude API key: https://platform.claude.com (Settings → API keys)
ANTHROPIC_API_KEY=
# Cloud computers: https://e2b.dev (Dashboard → API keys). Hobby plan includes $100 free credit.
E2B_API_KEY=

# ---- Your site ----
APP_NAME=Crewbase
NODE_ENV=production
PORT=3000
# Where the database lives. On Railway/Render, point this at a persistent volume (e.g. /data).
DATA_DIR=./data
# Your email(s) become admin. The first account created is also admin.
ADMIN_EMAILS=you@example.com
# Optional: only people with this code can sign up (good while you test).
INVITE_CODE=

# ---- Cost controls (you pay for these) ----
# Free agent work per user per month, in USD. Override per user on the Admin page.
FREE_MONTHLY_CREDIT_USD=1
MAX_AGENTS_PER_USER=5
MAX_CONCURRENT_RUNS=4
MAX_STEPS_PER_RUN=25
# Shortest allowed schedule (minutes)
MIN_SCHEDULE_MINUTES=60

# ---- AI models ----
DEFAULT_MODEL=claude-haiku-5-5
ALLOWED_MODELS=claude-haiku-5-5,claude-sonnet-5-5

# ---- Cloud computer details ----
E2B_TEMPLATE=base
# A run gets at most this many minutes of computer time before it pauses
SANDBOX_TIMEOUT_MINUTES=15
# Used for cost tracking. E2B default (2 vCPU, 4 GiB) ≈ 0.000046 $/s
SANDBOX_COST_PER_SECOND=0.000046
